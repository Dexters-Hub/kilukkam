{
  "name": "kilukkam",
  "compatibility_date": "2026-10-01",
  "main": "worker/src/index.ts",
  // web/dist comes from `npm run build`. /ws always reaches the Worker; unknown paths get index.html.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws"]
  },
  // One Room per room code; one Registry instance reserves the codes.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Registry"] }]
}
