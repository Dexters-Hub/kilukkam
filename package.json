{
  "name": "kilukkam",
  "private": true,
  "version": "0.1.0",
  "description": "Kilukkam turns a room full of phones into an orchestra: one conductor, one entry code, and every tap plays the next note of any song, together.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sim": "tsx scripts/room-sim.ts",
    "shot": "node scripts/shot.mjs",
    "check:dashes": "! grep -rIn --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=.playwright-mcp --exclude-dir=dist --exclude-dir=worktrees -e '\u2014' -e '\u2013' ."
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
